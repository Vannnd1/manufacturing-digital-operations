{
  "name": "manufacturing-digital-operations",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace=backend",
    "test:e2e": "npm run test:e2e --workspace=frontend",
    "test:e2e:ui": "npm run test:e2e:ui --workspace=frontend",
    "test:e2e:report": "npm run test:e2e:report --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "npm run seed --workspace=backend",
    "seed:reset": "npm run seed:reset --workspace=backend"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2"
  }
}
